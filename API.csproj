
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NCalc" Version="7.3.0" />
    <PackageReference Include="SPADE" Version="0.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <Content Include="Problems\**" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ProblemTemplate\Templates\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude standalone test projects -->
  <ItemGroup>
    <Compile Remove="redux-tests/**" />
    <Content Remove="redux-tests/**" />
    <None Remove="redux-tests/**" />
  </ItemGroup>

  <!-- Exclude contributor statistics console application -->
  <ItemGroup>
    <Compile Remove="Tools/ContributorStatsSync/**" />
    <Content Remove="Tools/ContributorStatsSync/**" />
    <None Remove="Tools/ContributorStatsSync/**" />
  </ItemGroup>

  <!--
  The NuGet library and its test project are built separately.
  Exclude their source files and resources from API.dll to prevent
  duplicate compilation and conflicts between projects.
  -->
  <ItemGroup>
    <Compile Remove="Redux.Library/**" />
    <Content Remove="Redux.Library/**" />
    <None Remove="Redux.Library/**" />
    <EmbeddedResource Remove="Redux.Library/**" />

    <Compile Remove="Redux.Library.Tests/**" />
    <Content Remove="Redux.Library.Tests/**" />
    <None Remove="Redux.Library.Tests/**" />
    <EmbeddedResource Remove="Redux.Library.Tests/**" />
  </ItemGroup>


  <!-- Integration tests against the built image live in integration/ (Redux.Integration.csproj),
       outside the solution. Same reasoning again: keep them out of API.dll. -->
  <ItemGroup>
    <Compile Remove="integration/**" />
    <Content Remove="integration/**" />
    <None Remove="integration/**" />
  </ItemGroup>


</Project>
